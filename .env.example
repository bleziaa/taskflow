# Copia este archivo como .env y rellena los valores reales.
# Nunca subas el archivo .env a un repositorio.
NODE_ENV=development
PORT=3000
# URL pública HTTPS del sistema, usada para construir enlaces de recuperación.
TASKFLOW_PUBLIC_URL=https://tu-dominio.example
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# MySQL/MariaDB (habilitar cuando la base y el usuario esten creados).
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=taskflow_relational
MYSQL_CONNECTION_LIMIT=5
SESSION_NAME=taskflow.sid
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
SESSION_MAX_AGE_MS=600000

# Almacenamiento híbrido de identidad visual:
# Desarrollo: almacenamiento local automático en storage/branding.
# Producción: Cloudinary con un unsigned upload preset restringido a imágenes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Correo saliente SMTP (opcional en desarrollo; obligatorio para enviar altas automáticamente).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@example.com
SMTP_PASS=
SMTP_FROM=TaskFlow <tu-correo@example.com>

# Asistente IA opcional (la clave solo vive en el servidor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
